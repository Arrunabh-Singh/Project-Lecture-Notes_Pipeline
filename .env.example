# --- Google Drive access (read-only) ---
# Fastest path: OAuth Playground (https://developers.google.com/oauthplayground)
#   1. Left panel -> Drive API v3 -> tick drive.readonly scope
#   2. Authorize APIs, sign in as the account the lectures were shared to
#   3. Exchange authorization code for tokens -> copy the access token
# A bare access token expires in ~1h. For the full 4GB library that's enough
# for one burst download; if it isn't, fill in the refresh-token trio below
# instead (Cloud project -> OAuth client -> "use your own credentials" in
# the Playground) so the pipeline can refresh automatically mid-run.
DRIVE_ACCESS_TOKEN=
DRIVE_REFRESH_TOKEN=
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=

# --- Gemini (speech-to-text + Files API) ---
# Free key, no card: https://aistudio.google.com/apikey
# Free tier note: Google may use submitted content to improve their
# products. This pipeline will send lecture audio through this key.
GEMINI_API_KEY=

# --- tuning (all optional, defaults shown) ---
GEMINI_RATE_LIMIT_RPM=6
GEMINI_MODEL=gemini-2.5-pro
